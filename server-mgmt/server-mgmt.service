[Unit]
Description=MPA Server Management API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=MGMT_DIR_PLACEHOLDER
ExecStart=MGMT_DIR_PLACEHOLDER/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8443 --ssl-certfile cert.pem --ssl-keyfile key.pem
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
